{
  "name": "taskbar2",
  "main": "main.js",
  "type": "module",
  "version": "0.8.3",
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "chrono-node": "^2.9.0",
    "dotenv": "^16.4.5",
    "electron-localshortcut": "^3.2.1",
    "google-auth-library": "^9.15.0",
    "googleapis": "^144.0.0",
    "rrule": "^2.8.1",
    "socket.io-client": "^4.8.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "electron": "39.2.6",
    "electron-builder": "^25.1.8"
  },
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "dev": "electron . --trace-warnings"
  },
  "build": {
    "appId": "com.taskbar2.app",
    "productName": "taskbar2",
    "icon": "dino.icns",
    "files": [
      "**/*",
      "!dist"
    ],
    "extraMetadata": {
      "env": {
        "GOOGLE_CLIENT_ID": "${GOOGLE_CLIENT_ID}",
        "GOOGLE_CLIENT_SECRET": "${GOOGLE_CLIENT_SECRET}",
        "APP_STAGE": "${APP_STAGE}"
      }
    }
  }
}
